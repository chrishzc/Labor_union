{
  "id": "contract_staff_service",
  "name": "服務人員契約（真實 Excel 鏡像模板）",
  "desc": "以複製後的服務人員契約 Excel 作為唯讀鏡像模板。",
  "template_filename": "服務人員契約.xlsx",
  "param_mappings": {
    "F1": {"label": "案件編號", "db_table": "orders", "db_key": "case_no", "requiredness": "required"},
    "C4": {"label": "服務人員姓名", "db_table": "staff", "db_key": "staff_name", "requiredness": "required"},
    "B5": {"label": "雇主姓名", "db_table": "clients", "db_key": "client_name", "requiredness": "required"},
    "B6": {"label": "預計開始日期", "db_table": "scheduling.assignment", "db_key": "assignment_start_date", "requiredness": "required"},
    "D6": {"label": "服務天數", "db_table": "orders", "db_key": "service_days", "requiredness": "required"},
    "B7": {"label": "服務開始日期", "db_table": "scheduling.assignment", "db_key": "assignment_start_date", "requiredness": "required"},
    "D7": {"label": "服務結束日期", "db_table": "scheduling.assignment", "db_key": "assignment_end_date", "requiredness": "required"},
    "G7": {"label": "服務天數", "db_table": "scheduling.assignment", "db_key": "assignment_service_days", "requiredness": "required"},
    "B8": {"label": "服務時段（clients.service_time）", "db_table": "clients.service_time", "db_key": "service_time", "requiredness": "required"},
    "B9": {"label": "休假方式（clients.service_type）", "db_table": "clients.service_type (canonical HCM service mode)", "db_key": "service_type", "requiredness": "required"},
    "B10": {"label": "服務單價", "db_table": "Payroll assignment rate snapshot", "db_key": "service_unit_price", "requiredness": "conditional", "applicability": "official_assignment_rate_present"},
    "E8": {"label": "胎數（Case Import named order-information projection）", "db_table": "case_import.order_information.multi_birth_count", "db_key": "multi_birth_count", "requiredness": "conditional", "status": "approved"},
    "F8": {"label": "生產方式（clients.delivery_type）", "db_table": "clients.delivery_type", "db_key": "delivery_type", "requiredness": "conditional"},
    "H8": {"label": "居住型態（clients.residence_type）", "db_table": "clients.residence_type", "db_key": "residence_type", "requiredness": "conditional"},
    "D15": {"label": "服務區域（clients.city）", "db_table": "clients.city", "db_key": "city", "requiredness": "required"},
    "B24": {"label": "服務地址", "db_table": "clients", "db_key": "address", "requiredness": "required"},
    "B94": {"label": "服務人員姓名", "db_table": "staff", "db_key": "staff_name", "requiredness": "required"},
    "B96": {"label": "服務人員電話", "db_table": "staff", "db_key": "staff_phone", "requiredness": "required"},
    "B13": {"label": "補助費用（現行模型無分拆）", "db_table": "Staff Payables whole obligation（legacy funding split absent/not applicable）", "db_key": "", "status": "not_applicable", "requiredness": "conditional", "applicability": "staff_payable_split_present"},
    "C13": {"label": "補助費用日期（現行模型無分拆）", "db_table": "Staff Payables whole obligation（legacy funding split absent/not applicable）", "db_key": "", "status": "not_applicable", "requiredness": "conditional", "applicability": "staff_payable_split_present"},
    "B15": {"label": "自費金額（現行模型無分拆）", "db_table": "Staff Payables whole obligation（legacy funding split absent/not applicable）", "db_key": "", "status": "not_applicable", "requiredness": "conditional", "applicability": "staff_payable_split_present"},
    "C15": {"label": "自費金額日期（現行模型無分拆）", "db_table": "Staff Payables whole obligation（legacy funding split absent/not applicable）", "db_key": "", "status": "not_applicable", "requiredness": "conditional", "applicability": "staff_payable_split_present"},
    "F10": {"label": "費用合計", "db_table": "staff_payables.service_obligation", "db_key": "staff_payable_total", "requiredness": "conditional", "applicability": "staff_payable_obligation_present"},
    "B19": {"label": "總計", "db_table": "staff_payables.service_obligation", "db_key": "staff_payable_total", "requiredness": "conditional", "applicability": "staff_payable_obligation_present"},
    "A97": {"label": "契約當天日期", "db_table": "Contract Signing command snapshot", "db_key": "__today__", "requiredness": "required"}
  }
}
