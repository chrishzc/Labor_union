      "checks": {
        "client_profile_change_apply_receipts.chk_client_profile_change_receipt_fingerprints": "and(atom(regexp_like(command_fingerprint,'^[0-9a-f]{64}$')),atom(regexp_like(preview_fingerprint,'^[0-9a-f]{64}$')))",
        "client_profile_change_apply_receipts.chk_client_profile_change_receipt_result": "atom(json_type(result_json)='OBJECT')",
        "client_profile_change_events.chk_client_profile_change_event_payload": "and(atom(json_type(before_values_json)='OBJECT'),atom(json_type(after_values_json)='OBJECT'))",
        "client_profile_change_outbox.chk_client_profile_change_outbox_payload": "atom(json_type(payload_json)='OBJECT')",
        "finance_import_source_correction_lineages.chk_finance_import_source_correction_distinct": "atom(original_batch_id<>corrected_successor_batch_id)",
        "government_subsidy_anomaly_apply_receipts.chk_government_anomaly_receipt_fingerprints": "and(atom(regexp_like(command_fingerprint,'^[0-9a-f]{64}$')),atom(regexp_like(preview_fingerprint,'^[0-9a-f]{64}$')))",
        "government_subsidy_anomaly_apply_receipts.chk_government_anomaly_receipt_result": "atom(json_type(result_snapshot)='OBJECT')",
        "government_subsidy_claim_correction_lineages.chk_government_claim_correction_fingerprint": "atom(regexp_like(preview_fingerprint,'^[0-9a-f]{64}$'))",
        "government_subsidy_claim_correction_lineages.chk_government_claim_correction_version": "atom(resulting_owner_version=expected_owner_version+1)",
        "government_subsidy_integrity_rebuild_events.chk_government_integrity_rebuild_fingerprint": "atom(regexp_like(preview_fingerprint,'^[0-9a-f]{64}$'))",
        "government_subsidy_integrity_rebuild_events.chk_government_integrity_rebuild_version": "atom(resulting_owner_version=expected_owner_version+1)",
        "government_subsidy_recoveries.chk_government_recovery_amounts": "and(atom(lawful_amount_ntd>=0),atom(actual_amount_ntd>lawful_amount_ntd),atom(excess_amount_ntd=actual_amount_ntd-lawful_amount_ntd),atom(remaining_excess_ntd>=0),atom(remaining_excess_ntd<=excess_amount_ntd))",
        "government_subsidy_recoveries.chk_government_recovery_status": "or(and(atom(status='open'),atom(remaining_excess_ntd=excess_amount_ntd)),and(atom(status='partially_reconciled'),atom(remaining_excess_ntd>0),atom(remaining_excess_ntd<excess_amount_ntd)),and(atom(status='reconciled'),atom(remaining_excess_ntd=0)))",
        "government_subsidy_recovery_events.chk_government_recovery_event_amount": "and(atom(amount_ntd>0),atom(before_remaining_ntd>0),atom(after_remaining_ntd=before_remaining_ntd-amount_ntd),atom(after_remaining_ntd>=0))",
        "government_subsidy_recovery_events.chk_government_recovery_event_fingerprint": "atom(regexp_like(preview_fingerprint,'^[0-9a-f]{64}$'))",
        "government_subsidy_recovery_events.chk_government_recovery_event_version": "atom(resulting_version=expected_version+1)",
        "payroll_late_obligation_dispositions.chk_payroll_late_disposition_fingerprints": "and(atom(regexp_like(command_fingerprint,'^[0-9a-f]{64}$')),atom(regexp_like(preview_fingerprint,'^[0-9a-f]{64}$')))",
        "payroll_late_obligation_dispositions.chk_payroll_late_disposition_versions": "and(atom(resulting_payroll_version=expected_payroll_version+1),atom(resulting_obligation_version=expected_obligation_version+1))"
