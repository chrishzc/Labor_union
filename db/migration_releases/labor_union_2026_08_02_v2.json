    "maintenance_token_required": true,
    "minimum_mysql_version": "8.0",
    "required_character_set": "utf8mb4",
    "source_must_be_read_only": true
  },
  "tool_archive_policy": {
    "artifact_hash_algorithm": "sha256",
    "backup_archive_policy": "permanent-release-archive",
    "journal_archive_policy": "append-only-per-operation",
    "mysqldump_required_options": [
      "--single-transaction",
      "--routines",
      "--events",
      "--triggers",
      "--hex-blob"
    ],
    "receipt_archive_policy": "permanent-release-archive",
    "restore_required_mode": "new-absent-candidate-only"
  },
  "verification_contracts": [
    {
      "blocking": true,
      "phase": "post-restore",
      "policy": "restored-schema-programs-equivalent",
      "read_only": true,
      "verification_id": "restored-schema-programs"
    },
    {
      "blocking": true,
      "phase": "post-schema",
      "policy": "candidate-owned-objects-exact",
      "read_only": true,
      "verification_id": "owned-object-descriptors"
    },
    {
      "blocking": true,
      "phase": "post-backfill",
      "policy": "source-row-pk-and-full-row-fingerprint-unchanged",
      "read_only": true,
      "verification_id": "source-preservation"
    },
    {
      "blocking": true,
      "phase": "pre-switch",
      "policy": "orders-legacy-projection-unchanged",
      "read_only": true,
      "verification_id": "legacy-projection-compatibility"
    },
    {
      "blocking": true,
      "phase": "post-restart",
      "policy": "all-application-smoke-ids-pass",
      "read_only": true,
      "verification_id": "application-read-smoke"
    }
  ]
}
