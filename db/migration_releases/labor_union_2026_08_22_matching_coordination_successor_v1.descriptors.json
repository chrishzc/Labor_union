      "checks": {
        "matching_coordination_criteria_snapshots.chk_matching_criteria_identity": "and(atom(char_length(trim(snapshot_id))>0),atom(char_length(trim(case_no))>0))",
        "matching_coordination_criteria_snapshots.chk_matching_criteria_payload": "and(atom(json_type(criteria_snapshot)='OBJECT'),atom(json_length(criteria_snapshot)>0))",
        "matching_coordination_criteria_snapshots.chk_matching_criteria_sources": "and(atom(json_type(source_version_tuple)='ARRAY'),atom(json_length(source_version_tuple)>0))",
        "matching_coordination_criteria_snapshots.chk_matching_criteria_digest": "atom(regexp_like(criteria_digest,'^[0-9a-f]{64}$'))",
        "matching_coordination_criteria_snapshots.chk_matching_criteria_actor": "atom(char_length(trim(actor_ref))>0)",
        "matching_coordination_package_lineage.chk_matching_package_identity": "and(atom(char_length(trim(package_id))>0),atom(char_length(trim(case_no))>0))",
        "matching_coordination_package_lineage.chk_matching_package_payload": "and(atom(json_type(package_snapshot)='OBJECT'),atom(json_length(package_snapshot)>0))",
        "matching_coordination_package_lineage.chk_matching_package_sources": "and(atom(json_type(source_version_tuple)='ARRAY'),atom(json_length(source_version_tuple)>0))",
        "matching_coordination_package_lineage.chk_matching_package_digest": "atom(regexp_like(package_digest,'^[0-9a-f]{64}$'))",
        "matching_coordination_package_lineage.chk_matching_package_actor": "atom(char_length(trim(actor_ref))>0)",
        "matching_coordination_package_lineage.chk_matching_package_parent": "or(and(atom(lineage_kind='initial'),atom(parent_package_idisnull)),and(atom(lineage_kind<>'initial'),atom(parent_package_idisnotnull)))",
        "matching_coordination_events.chk_matching_event_identity": "and(atom(char_length(trim(event_id))>0),atom(char_length(trim(case_no))>0),atom(char_length(trim(idempotency_key))>0),atom(char_length(trim(correlation_id))>0))",
        "matching_coordination_events.chk_matching_event_payload": "and(atom(json_type(event_payload)='OBJECT'),atom(json_length(event_payload)>0))",
        "matching_coordination_events.chk_matching_event_sources": "and(atom(json_type(source_version_tuple)='ARRAY'),atom(json_length(source_version_tuple)>0))",
        "matching_coordination_events.chk_matching_event_versions": "atom(resulting_version>=expected_version)",
        "matching_coordination_events.chk_matching_event_digest": "atom(regexp_like(event_digest,'^[0-9a-f]{64}$'))",
        "matching_coordination_events.chk_matching_event_actor": "atom(char_length(trim(actor_ref))>0)",
        "matching_coordination_apply_receipts.chk_matching_receipt_identity": "and(atom(char_length(trim(receipt_id))>0),atom(char_length(trim(command_name))>0),atom(char_length(trim(idempotency_key))>0),atom(char_length(trim(actor_ref))>0),atom(char_length(trim(correlation_id))>0))",
        "matching_coordination_apply_receipts.chk_matching_receipt_fingerprints": "and(atom(regexp_like(command_fingerprint,'^[0-9a-f]{64}$')),or(atom(preview_fingerprintisnull),atom(regexp_like(preview_fingerprint,'^[0-9a-f]{64}$'))))",
        "matching_coordination_apply_receipts.chk_matching_receipt_sources": "and(atom(json_type(source_version_tuple)='ARRAY'),atom(json_length(source_version_tuple)>0))",
        "matching_coordination_apply_receipts.chk_matching_receipt_result": "and(atom(json_type(result_snapshot)='OBJECT'),atom(json_length(result_snapshot)>0))",
        "matching_coordination_outbox.chk_matching_outbox_identity": "and(atom(char_length(trim(reference_id))>0),atom(char_length(trim(case_no))>0),atom(char_length(trim(idempotency_key))>0),atom(char_length(trim(correlation_id))>0))",
        "matching_coordination_outbox.chk_matching_outbox_target": "or(and(atom(intent_typein('line_matching_interaction','line_criteria_diff_resend')),atom(target_owner='line_integration')),and(atom(intent_typein('assignment_conversion_requested','rematch_requested')),atom(target_owner='assignment_workflow')),and(atom(intent_type='orders_terms_update_requested'),atom(target_owner='orders_workflow')))",
        "matching_coordination_outbox.chk_matching_outbox_payload": "and(atom(json_type(intent_payload)='OBJECT'),atom(json_length(intent_payload)>0))",
        "matching_coordination_outbox.chk_matching_outbox_sources": "and(atom(json_type(source_version_tuple)='ARRAY'),atom(json_length(source_version_tuple)>0))",
        "matching_coordination_outbox.chk_matching_outbox_digest": "atom(regexp_like(reference_digest,'^[0-9a-f]{64}$'))"
      },
