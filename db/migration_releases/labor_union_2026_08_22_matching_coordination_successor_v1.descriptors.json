        "matching_coordination_package_lineage.fk_matching_package_parent": {"columns": ["parent_package_id"], "referenced_table": "matching_coordination_package_lineage", "referenced_columns": ["id"], "update_rule": "RESTRICT", "delete_rule": "RESTRICT"},
