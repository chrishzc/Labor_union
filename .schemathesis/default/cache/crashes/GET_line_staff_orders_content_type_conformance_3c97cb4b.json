u5730\u5740\", `${valueText(item.city)} ${valueText(item.address)}`],\n      [\"\u6848\u4ef6\u72c0\u614b\", item.order_status],\n      [\"\u670d\u52d9\u671f\u9593\", `${valueText(item.start_date)} \u81f3 ${valueText(item.end_date)}`],\n      [\"\u670d\u52d9\u5929\u6578\", item.service_days],\n      [\"\u6bcf\u65e5\u6642\u6578\", item.service_hours_per_day],\n      [\"\u9810\u7522\u671f/\u9810\u8a08\u6708\u4efd\", item.due_month],\n      [\"\u9810\u8a08\u670d\u52d9\u65e5\u671f\", item.service_start_date],\n      [\"\u670d\u52d9\u6642\u9593\", item.service_time],\n      [\"\u5c45\u4f4f\u578b\u614b\", item.residence_type],\n      [\"\u751f\u7522\u65b9\u5f0f\", item.delivery_type],\n      [\"\u670d\u52d9\u65b9\u5f0f\", item.service_type],\n      [\"\u5bf6\u5bf6\u8cc7\u8a0a\", item.baby_info],\n      [\"\u5176\u4ed6\u4e8b\u9805\", item.notes],\n    ];\n    const card = document.createElement(\"article\");\n    card.className = \"order\";\n    card.innerHTML = `<h2>${valueText(item.client_name)}\uff5c${valueText(item.case_no)}</h2>\n      <div class=\"grid\">${rows.map(([k, v]) => `<div class=\"item\"><b>${k}</b>${valueText(v)}</div>`).join(\"\")}</div>`;\n    if (item.survey_rows && item.survey_rows.length) {\n      const details = document.createElement(\"details\");\n      details.innerHTML = `<summary>\u67e5\u770b\u5b8c\u6574\u8868\u55ae\u586b\u5beb\u5167\u5bb9</summary>\n        <div class=\"grid\">${item.survey_rows.map(row => `<div class=\"item\"><b>${row.label}</b>${valueText(row.value)}</div>`).join(\"\")}</div>`;\n      card.appendChild(details);\n    }\n    root.appendChild(card);\n  }\n}\n\nasync function init() {\n  const searchButton = document.getElementById(\"searchBtn\");\n  searchButton.disabled = true;\n  searchButton.textContent = \"\u6b63\u5728\u78ba\u8a8d LINE \u8eab\u5206...\";\n  const params = new URLSearchParams(location.search);\n  flowId = params.get(\"flow_id\") || \"\";\n  try {\n    const result = await fetch(\"/api/v1/line/identity/runtime-config\").then(r => r.json());\n    const config = result.data || {};\n    if (config.liff_id) {\n      await liff.init({ liffId: config.liff_id });\n      if (!liff.isLoggedIn()) {\n        if (flowId) {\n          identityReady = true;\n          return;\n        }\n        liff.login();\n        return;\n      }\n      await captureLineIdentity();\n    }\n    if (!identityReady && !flowId) {\n      showStatus(\"\u7121\u6cd5\u53d6\u5f97 LINE \u8eab\u5206\uff0c\u8acb\u95dc\u9589\u6b64\u9801\u5f8c\u5f9e LINE \u5716\u6587\u9078\u55ae\u91cd\u65b0\u958b\u555f\u3002\", true);\n    }\n  } catch (err) {\n    showStatus(\"LIFF \u521d\u59cb\u5316\u5931\u6557\uff0c\u8acb\u91cd\u65b0\u958b\u555f\u9801\u9762\u3002\", true);\n  } finally {\n    searchButton.disabled = false;\n    searchButton.textContent = \"\u67e5\u8a62\u8a02\u55ae\u8cc7\u8a0a\";\n  }\n}\n\ndocument.getElementById(\"searchBtn\").addEventListener(\"click\", async () => {\n  const keyword = document.getElementById(\"keyword\").value.trim();\n  if (!keyword) {\n    showStatus(\"\u8acb\u5148\u8f38\u5165\u6848\u4ef6\u7de8\u865f\u6216\u5ba2\u6236\u59d3\u540d\u3002\", true);\n    return;\n  }\n  if (!identityReady && !flowId && !lineIdToken) {\n    showStatus(\"LINE \u8eab\u5206\u5c1a\u672a\u8f09\u5165\u5b8c\u6210\uff0c\u8acb\u7a0d\u5019\u518d\u67e5\u8a62\uff1b\u82e5\u4ecd\u5931\u6557\uff0c\u8acb\u95dc\u9589\u6b64\u9801\u5f8c\u5f9e LINE \u5716\u6587\u9078\u55ae\u91cd\u65b0\u958b\u555f\u3002\", true);\n    return;\n  }\n  showStatus(\"\u67e5\u8a62\u4e2d...\");\n  const response = await fetch(\"/api/v1/line/staff-self-service/orders\", {\n    method: \"POST\",\n    headers: {\"Content-Type\": \"application/json\"},\n    body: JSON.stringify({ keyword, flow_id: flowId, line_id_token: lineIdToken })\n  });\n  const data = await response.json();\n  if (!response.ok || !data.success) {\n    showStatus(data.message || data.detail?.message || \"\u67e5\u8a62\u5931\u6557\", true);\n    document.getElementById(\"results\").innerHTML = \"\";\n    return;\n  }\n  renderResults(data.data?.items || []);\n});\n\ninit();\n</script>\n</body>\n</html>\n"
