 box.textContent = text;\n  box.className = \"message\" + (isError ? \" error\" : \"\");\n  box.style.display = \"block\";\n}\n\nfunction identityPayload() {\n  return { flow_id: flowId, line_id_token: lineIdToken };\n}\n\nfunction renderCalendar(schedule) {\n  const root = document.getElementById(\"calendar\");\n  const year = schedule.year;\n  const month = schedule.month;\n  const first = new Date(year, month - 1, 1);\n  const lastDay = new Date(year, month, 0).getDate();\n  const weekNames = [\"\u65e5\", \"\u4e00\", \"\u4e8c\", \"\u4e09\", \"\u56db\", \"\u4e94\", \"\u516d\"];\n  const byDay = {};\n  for (const item of schedule.days || []) {\n    const day = Number(String(item.work_date).slice(-2));\n    if (!byDay[day]) byDay[day] = [];\n    byDay[day].push(item);\n  }\n  root.innerHTML = weekNames.map(name => `<div class=\"head\">${name}</div>`).join(\"\");\n  for (let i = 0; i < first.getDay(); i++) root.insertAdjacentHTML(\"beforeend\", `<div class=\"day available\"></div>`);\n  for (let day = 1; day <= lastDay; day++) {\n    const items = byDay[day] || [];\n    const workItems = items.filter(item => item.status === \"working\");\n    const restItems = items.filter(item => item.status === \"resting\");\n    const css = workItems.length ? \"work\" : (restItems.length ? \"rest\" : \"available\");\n    const text = workItems.length\n      ? workItems.map(item => `${item.client_name || \"\u670d\u52d9\u6848\u4ef6\"} ${item.case_no || \"\"}`).join(\"<br>\")\n      : (restItems.length ? \"\u4f11\u606f/\u8acb\u5047\" : \"\u672a\u6392\u73ed\");\n    root.insertAdjacentHTML(\"beforeend\", `<div class=\"day ${css}\"><div class=\"date\">${day}</div><div>${text}</div></div>`);\n  }\n}\n\nasync function loadSchedule() {\n  const value = document.getElementById(\"monthInput\").value;\n  if (!value) {\n    show(\"calendarStatus\", \"\u8acb\u5148\u9078\u64c7\u67e5\u8a62\u6708\u4efd\u3002\", true);\n    return;\n  }\n  const [year, month] = value.split(\"-\").map(Number);\n  show(\"calendarStatus\", \"\u73ed\u8868\u67e5\u8a62\u4e2d...\");\n  const response = await fetch(`/api/v1/line/staff-self-service/schedule?year=${year}&month=${month}`, {\n    method: \"POST\",\n    headers: {\"Content-Type\": \"application/json\"},\n    body: JSON.stringify(identityPayload())\n  });\n  const data = await response.json();\n  if (!response.ok || data.success === false || !data.data) {\n    show(\"calendarStatus\", data.message || data.detail?.message || \"\u67e5\u8a62\u5931\u6557\", true);\n    return;\n  }\n  show(\"calendarStatus\", `${data.data.staff_name} \u7684 ${year} \u5e74 ${month} \u6708\u6392\u73ed`);\n  renderCalendar(data.data);\n}\n\nasync function init() {\n  const now = new Date();\n  document.getElementById(\"monthInput\").value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, \"0\")}`;\n  const params = new URLSearchParams(location.search);\n  lineUserId = params.get(\"userId\") || \"\";\n  flowId = params.get(\"flow_id\") || \"\";\n  try {\n    const result = await fetch(\"/api/v1/line/identity/runtime-config\").then(r => r.json());\n    const config = result.data || {};\n    if (config.liff_id) {\n      await liff.init({ liffId: config.liff_id });\n      if (!liff.isLoggedIn()) {\n        if (flowId || lineUserId) return;\n        liff.login();\n        return;\n      }\n      await captureLineIdentity();\n    }\n  } catch (_) {\n    show(\"calendarStatus\", \"LIFF \u521d\u59cb\u5316\u5931\u6557\uff0c\u8acb\u91cd\u65b0\u958b\u555f\u9801\u9762\u3002\", true);\n  }\n  loadSchedule();\n}\n\ndocument.getElementById(\"loadSchedule\").addEventListener(\"click\", loadSchedule);\ninit();\n</script>\n</body>\n</html>\n"
