        "body": "<!doctype html>\n<!-- LINE LIFF \u8eab\u5206\u7d81\u5b9a\u9801\uff1a\u4f9d flow purpose \u986f\u793a\u5ba2\u6236\u3001\u6708\u5ac2\u6216\u5de5\u6703\u5e33\u865f\u8868\u55ae\u3002 -->\n<html lang=\"zh-Hant\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>LINE \u8eab\u5206\u78ba\u8a8d</title>\n  <script src=\"https://static.line-scdn.net/liff/edge/2/sdk.js\"></script>\n  <style>\n    body { margin: 0; min-height: 100vh; background: linear-gradient(135deg,#eef2f7,#d9e2ec); color: #334e68; font-family: 'Noto Sans TC',sans-serif; }\n    main { max-width: 480px; margin: 0 auto; padding: 28px 18px; }\n    section { position: relative; overflow: hidden; background: #ffffffd9; border: 1px solid #ffffff80; border-radius: 20px; padding: 28px; box-shadow: 0 8px 32px #1f268715; }\n    section::before { content: ''; position: absolute; inset: 0 0 auto; height: 6px; background: linear-gradient(90deg,#4a90e2,#63e6be); }\n    h1 { margin-top: 0; font-size: 24px; }\n    label { display: block; margin: 16px 0 6px; font-weight: 700; }\n    input { box-sizing: border-box; width: 100%; padding: 12px; border: 1px solid #c9d1d9; border-radius: 9px; font-size: 16px; }\n    button { width: 100%; margin-top: 22px; padding: 13px; border: 0; border-radius: 9px; background: #06c755; color: white; font-size: 17px; font-weight: 700; }\n    button:disabled { opacity: .55; }\n    #customer-choice button { margin-top: 14px; text-align: left; padding: 18px; border: 1px solid #d9e2ec; background: #fff; color: #334e68; box-shadow: 0 4px 15px #00000008; }\n    #customer-choice button strong { display: block; font-size: 17px; margin-bottom: 5px; }\n    #customer-choice button span { display: block; color: #627d98; font-size: 13px; line-height: 1.5; }\n    #message { margin-top: 16px; white-space: pre-wrap; line-height: 1.5; }\n    .error { color: #b42318; }\n  </style>\n</head>\n<body>\n<main><section>\n  <h1 id=\"title\">LINE \u8eab\u5206\u78ba\u8a8d</h1>\n  <p id=\"description\">\u6b63\u5728\u78ba\u8a8d\u767b\u5165\u72c0\u614b\u2026</p>\n  <div id=\"customer-choice\" hidden>\n    <button id=\"bind-existing\" type=\"button\"><strong>\ud83d\udcdd \u5df2\u767b\u8a18\u670d\u52d9\uff0f\u88dc\u52a9</strong><span>\u6211\u5df2\u586b\u5beb BeClass \u6216\u653f\u5e9c\u88dc\u52a9\u8cc7\u6599\uff0c\u8981\u76f4\u63a5\u7d81\u5b9a\u4e26\u67e5\u8a62\u9032\u5ea6\u3002</span></button>\n    <button id=\"register-new\" type=\"button\"><strong>\u2728 \u5c1a\u672a\u586b\u5beb\u767b\u8a18\u8868\u55ae</strong><span>\u6211\u662f\u65b0\u5ba2\u6236\uff0c\u8981\u586b\u5beb\u5b8c\u6574\u8cc7\u6599\u4e26\u5efa\u7acb\u670d\u52d9\u6a94\u6848\u3002</span></button>\n  </div>\n  <form id=\"form\" hidden></form>\n  <div id=\"message\" role=\"status\"></div>\n</section></main>\n<script>\nconst definitions = {\n  customer_binding: {\n    title: \"\u5ba2\u6236\u8cc7\u6599\u7d81\u5b9a\",\n    description: \"\u8acb\u8f38\u5165\u767b\u8a18\u6642\u4f7f\u7528\u7684\u59d3\u540d\u8207\u96fb\u8a71\u3002\",\n    endpoint: \"customer\",\n    fields: [[\"name\", \"\u59d3\u540d\", \"text\"], [\"phone\", \"\u884c\u52d5\u96fb\u8a71\", \"tel\"]]\n  },\n  staff_verification: {\n    title: \"\u6708\u5ac2\u8eab\u5206\u7533\u8acb\",\n    description: \"\u8cc7\u6599\u6838\u5c0d\u5f8c\u6703\u9001\u4ea4\u5de5\u6703\u4eba\u54e1\u78ba\u8a8d\uff0c\u4e0d\u6703\u7acb\u5373\u5207\u63db\u8eab\u5206\u3002\",\n    endpoint: \"staff\",\n    fields: [[\"name\", \"\u59d3\u540d\", \"text\"], [\"identity_card\", \"\u8eab\u5206\u8b49\u5b57\u865f\", \"text\"], [\"birthday\", \"\u751f\u65e5\", \"date\"]]\n  },\n  admin_binding: {\n    title: \"\u5de5\u6703\u5e33\u865f\u7d81\u5b9a\",\n    description: \"\u8acb\u4f7f\u7528\u65e2\u6709\u5f8c\u53f0\u5e33\u865f\u767b\u5165\uff1b\u672c\u64cd\u4f5c\u4e0d\u6703\u8b8a\u66f4\u60a8\u7684\u6b0a\u9650\u3002\",\n    endpoint: \"admin\",\n    fields: [[\"username\", \"\u5f8c\u53f0\u5e33\u865f\", \"text\"], [\"password\", \"\u5f8c\u53f0\u5bc6\u78bc\", \"password\"]]\n  }\n};\nlet idToken = \"\";\nlet flowId = \"\";\nlet formBuilt = false;\nconst developmentLineUserId = new URLSearchParams(location.search).get(\"userId\") || \"\";\n\nfunction showMessage(text, isError = false) {\n  const target = document.getElementById(\"message\");\n  target.textContent = text;\n  target.className = isError ? \"error\" : \"\";\n}\n\nfunction buildForm(definition) {\n  if (formBuilt) return;\n  const form = document.getElementById(\"form\");\n  for (const [name, labelText, type] of definition.fields) {\n    const label = document.createElement(\"label\");\n    label.htmlFor = name;\n    label.textContent = labelText;\n    const input = document.createElement(\"input\");\n    input.id = name;\n    input.name = name;\n    input.type = type;\n    input.required = true;\n    input.maxLength = type === \"password\" ? 256 : 100;\n    form.append(label, input);\n  }\n  const button = document.createElement(\"button\");\n  button.type = \"submit\";\n  button.textContent = \"\u9001\u51fa\u78ba\u8a8d\";\n  form.append(button);\n  form.addEventListener(\"submit\", event => submitForm(event, definition, button));\n  formBuilt = true;\n}\n\nfunction showIdentityEntry(definition, purpose) {\n  buildForm(definition);\n  if (purpose !== \"customer_binding\") {\n    document.getElementById(\"form\").hidden = false;\n    return;\n  }\n  document.getElementById(\"description\").textContent = \"\u8acb\u9078\u64c7\u60a8\u662f\u5426\u5df2\u586b\u5beb\u904e\u5de5\u6703\u57fa\u672c\u8cc7\u6599\u8868\u55ae\u3002\";\n  document.getElementById(\"customer-choice\").hidden = false;\n}\n\nasync function ensureLineIdToken() {\n  idToken = liff.getIDToken() || \"\";\n  if (!idToken && !developmentLineUserId) {\n    throw new Error(\"\u7121\u6cd5\u53d6\u5f97 LINE \u767b\u5165\u6191\u8b49\uff0c\u8acb\u78ba\u8a8d LIFF \u5df2\u555f\u7528 openid \u6b0a\u9650\u5f8c\u91cd\u65b0\u958b\u555f\u6b64\u9801\u3002\");\n  }\n  return idToken;\n}\n\nasync function currentLineUserId() {\n  try {\n    const context = liff.getContext && liff.getContext();\n    if (context?.userId) return context.userId;\n  } catch (_) {}\n  try {\n    const profile = await liff.getProfile();\n    if (profile?.userId) return profile.userId;\n  } catch (_) {}\n  return developmentLineUserId;\n}\n\nasync function openStaffPage(path) {\n  await openIdentityFlow(\"staff_self_service\");\n  const target = new URL(path, location.origin);\n  target.searchParams.set(\"flow_id\", flowId);\n  location.replace(target.toString());\n}\n\nasync function openIdentityFlow(purpose) {\n  await ensureLineIdToken();\n  const storageKey = `line-flow-idempotency:${purpose}`;\n  const idempotencyKey = sessionStorage.getItem(storageKey) || crypto.randomUUID();\n  sessionStorage.setItem(storageKey, idempotencyKey);\n  const response = await fetch(\"/api/v1/line/identity/flow/open\", {\n    method: \"POST\",\n    headers: {\"Content-Type\": \"application/json\"},\n    body: JSON.stringify({\n      purpose,\n      idempotency_key: idempotencyKey,\n      line_id_token: idToken,\n      development_line_user_id: developmentLineUserId\n    })\n  });\n  const result = await response.json();\n  if (!response.ok) {\n    const detail = typeof result.detail === \"string\" ? result.detail : result.detail?.message;\n    throw new Error(detail || \"\u76ee\u524d\u7121\u6cd5\u5efa\u7acb\u5b89\u5168\u64cd\u4f5c\u9023\u7d50\uff0c\u8acb\u7a0d\u5f8c\u518d\u8a66\u3002\");\n  }\n  flowId = result.data.flow_id;\n  return result.data;\n}\n\nfunction configureCustomerChoice(definition) {\n  document.getElementById(\"bind-existing\").addEventListener(\"click\", async () => {\n    try {\n      showMessage(\"\u6b63\u5728\u5efa\u7acb\u5b89\u5168\u7d81\u5b9a\u6d41\u7a0b\u2026\");\n      await openIdentityFlow(\"customer_binding\");\n      await validateIdentityFlow(\"customer_binding\");\n      showMessage(\"\");\n    } catch (error) {\n      showMessage(error.message || \"\u76ee\u524d\u7121\u6cd5\u5efa\u7acb\u5b89\u5168\u7d81\u5b9a\u6d41\u7a0b\u3002\", true);\n      return;\n    }\n    document.getElementById(\"customer-choice\").hidden = true;\n    document.getElementById(\"description\").textContent = definition.description;\n    document.getElementById(\"form\").hidden = false;\n  });\n  document.getElementById(\"register-new\").addEventListener(\"click\", async () => {\n    try {\n      showMessage(\"\u6b63\u5728\u5efa\u7acb\u5b89\u5168\u767b\u8a18\u6d41\u7a0b\u2026\");\n      await openIdentityFlow(\"customer_binding\");\n      location.assign(`/line-registration?flow_id=${encodeURIComponent(flowId)}`);\n    } catch (error) {\n      showMessage(error.message || \"\u76ee\u524d\u7121\u6cd5\u958b\u555f\u670d\u52d9\u767b\u8a18\u8868\u55ae\u3002\", true);\n    }\n  });\n}\n\nasync function submitForm(event, definition, button) {\n  event.preventDefault();\n  button.disabled = true;\n  showMessage(\"\u6b63\u5728\u5b89\u5168\u6838\u5c0d\u8cc7\u6599\u2026\");\n  const values = Object.fromEntries(new FormData(event.target).entries());\n  const payload = {flow_id: flowId, line_id_token: idToken, ...values};\n  if (developmentLineUserId) payload.development_line_user_id = developmentLineUserId;\n  try {\n    const response = await fetch(`/api/v1/line/identity/${definition.endpoint}/apply`, {\n      method: \"POST\", headers: {\"Content-Type\": \"application/json\"}, body: JSON.stringify(payload)\n    });\n    const result = await response.json();\n    if (!response.ok) throw new Error(result.detail || \"\u8cc7\u6599\u9001\u51fa\u5931\u6557\");\n    const pending = result.data.status === \"pending_review\";\n    showMessage(pending ? \"\u7533\u8acb\u5df2\u9001\u51fa\uff0c\u8acb\u7b49\u5f85\u5de5\u6703\u4eba\u54e1\u78ba\u8a8d\u3002\" : \"LINE \u8eab\u5206\u5df2\u5b8c\u6210\u7d81\u5b9a\u3002\", false);\n    event.target.querySelectorAll(\"input,button\").forEach(item => item.disabled = true);\n  } catch (error) {\n    showMessage(error.message || \"\u76ee\u524d\u7121\u6cd5\u9001\u51fa\uff0c\u8acb\u7a0d\u5f8c\u518d\u8a66\u3002\", true);\n    button.disabled = false;\n  }\n}\n\nasync function loadLiffId() {\n  const response = await fetch(\"/api/v1/line/identity/runtime-config\");\n  const result = await response.json();\n  if (!response.ok || !result.data?.liff_id) {\n    throw new Error(\"LIFF \u5c1a\u672a\u5b8c\u6210\u8a2d\u5b9a\uff0c\u8acb\u806f\u7d61\u5de5\u6703\u4eba\u54e1\u3002\");\n  }\n  return result.data.liff_id;\n}\n\nfunction liffStateParameters(parameters) {\n  const rawState = parameters.get(\"liff.state\") || \"\";\n  const queryStart = rawState.indexOf(\"?\");\n  const stateQuery = queryStart >= 0 ? rawState.slice(queryStart + 1) : rawState.replace(/^\\//, \"\");\n  return new URLSearchParams(stateQuery);\n}\n\nfunction combinedEntryParameters() {\n  const parameters = new URLSearchParams(location.search);\n  const stateParameters = liffStateParameters(parameters);\n  return {parameters, stateParameters};\n}\n\nfunction identityFlowParameters() {\n  const {parameters, stateParameters} = combinedEntryParameters();\n  if (parameters.get(\"purpose\") && parameters.get(\"flow_id\")) return parameters;\n  return stateParameters;\n}\n\nfunction readIdentityFlowContext() {\n  const parameters = identityFlowParameters();\n  const purpose = parameters.get(\"purpose\") || \"\";\n  const definition = definitions[purpose];\n  flowId = parameters.get(\"flow_id\") || \"\";\n  if (!flowId || !definition) {\n    throw new Error(\"\u9023\u7d50\u7121\u6548\uff0c\u8acb\u56de\u5230 LINE \u91cd\u65b0\u53d6\u5f97\u5165\u53e3\u3002\");\n  }\n  return {definition, purpose};\n}\n\nfunction requestedRegistrationEntry() {\n  const {parameters, stateParameters} = combinedEntryParameters();\n  const entry = parameters.get(\"entry\") || stateParameters.get(\"entry\");\n  return entry === \"registration\";\n}\n\nfunction requestedStaffPage() {\n  const {parameters, stateParameters} = combinedEntryParameters();\n  const target = parameters.get(\"target\") || stateParameters.get(\"target\");\n  return {staff_order_search: \"/line-staff-orders\", staff_schedule: \"/line-staff-schedule\"}[target] || \"\";\n}\n\nfunction hasSensitiveFlowContext() {\n  const parameters = identityFlowParameters();\n  return Boolean(parameters.get(\"purpose\") || parameters.get(\"flow_id\"));\n}\n\nfunction showRegistrationEntry() {\n  const definition = definitions.customer_binding;\n  document.getElementById(\"title\").textContent = \"\u670d\u52d9\u767b\u8a18\";\n  document.getElementById(\"description\").textContent = \"\u8acb\u9078\u64c7\u60a8\u662f\u5426\u5df2\u586b\u5beb\u904e\u5de5\u6703\u57fa\u672c\u8cc7\u6599\u8868\u55ae\u3002\";\n  configureCustomerChoice(definition);\n  buildForm(definition);\n  document.getElementById(\"customer-choice\").hidden = false;\n}\n\nasync function validateIdentityFlow(purpose) {\n  const payload = {flow_id: flowId, purpose, line_id_token: idToken};\n  if (developmentLineUserId) payload.development_line_user_id = developmentLineUserId;\n  const response = await fetch(\"/api/v1/line/identity/flow/validate\", {\n    method: \"POST\",\n    headers: {\"Content-Type\": \"application/json\"},\n    body: JSON.stringify(payload)\n  });\n  if (response.ok) return;\n  const result = await response.json();\n  if (response.status === 410) {\n    throw new Error(\"\u6b64\u9023\u7d50\u5df2\u5931\u6548\uff0c\u8acb\u56de\u5230 LINE \u91cd\u65b0\u53d6\u5f97\u9023\u7d50\u3002\");\n  }\n  const detail = typeof result.detail === \"string\" ? result.detail : result.detail?.message;\n  throw new Error(detail || \"\u76ee\u524d\u7121\u6cd5\u9a57\u8b49\u9023\u7d50\uff0c\u8acb\u7a0d\u5f8c\u518d\u8a66\u3002\");\n}\n\nasync function initialize() {\n  const liffId = await loadLiffId();\n  await liff.init({liffId});\n  const staffPage = requestedStaffPage();\n  if (!liff.isLoggedIn()) { liff.login(); return; }\n  if (staffPage) { await openStaffPage(staffPage); return; }\n  if (requestedRegistrationEntry() || !hasSensitiveFlowContext()) {\n    showRegistrationEntry();\n    return;\n  }\n  const {definition, purpose} = readIdentityFlowContext();\n  document.getElementById(\"title\").textContent = definition.title;\n  document.getElementById(\"description\").textContent = definition.description;\n  await ensureLineIdToken();\n  await validateIdentityFlow(purpose);\n  configureCustomerChoice(definition);\n  showIdentityEntry(definition, purpose);\n}\n\ninitialize().catch(error => showMessage(error.message || \"\u9801\u9762\u521d\u59cb\u5316\u5931\u6557\u3002\", true));\n</script>\n</body>\n</html>\n"
      },
