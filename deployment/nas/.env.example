# File: .env.example
# Description: NAS MySQL 資料庫部署環境變數範本（不含密碼；密碼放受保護的 mysql-secrets 目錄）。

# Container Manager 專案名稱（備份與升級腳本依此名稱辨識資料卷，建立後請勿改名）
COMPOSE_PROJECT_NAME=labor-union-nas-db

# MySQL 官方映像標籤
MYSQL_IMAGE=mysql:8.0.46

# 【必填】NAS 在區網內的固定 IPv4（例如 192.168.1.100）；DSM 防火牆只允許工會電腦 IP 連入 3306
NAS_DB_BIND_IP=
NAS_DB_PORT=3306

# 資料庫與應用程式帳號名稱（實際密碼存於 ./mysql-secrets/root-password 與 app-password，不寫入 .env）
MYSQL_DATABASE=union_db
MYSQL_USER=union_app
NAS_MYSQL_SECRETS_DIR=./mysql-secrets

# 資源與效能參數（依 NAS 記憶體調整）
TZ=Asia/Taipei
NAS_MYSQL_MEMORY=1024m
MYSQL_INNODB_BUFFER_POOL=256M
MYSQL_MAX_CONNECTIONS=60
