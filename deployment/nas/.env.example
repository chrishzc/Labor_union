# 使用前：複製為同目錄的 .env，以 UTF-8 儲存，不要命名成 .env.txt。
# 新安裝才複製此範本；已安裝的 NAS 更新時保留原 .env，不用本範本覆蓋。
# compose.yaml 引用已存在的「專案名稱_data」內部網路，使用前依 README 確認。

# 【必填】Container Manager 名稱必須相同；已安裝後不可因換版而改名。
COMPOSE_PROJECT_NAME=labor-union-nas-dsm-20261020

# 已建置並上傳；此 DSM 反向代理方案沿用現有映像，不需重建。
NAS_IMAGE=chris23144638/cecec:nas-secure-20261020

# 【必填：NAS 路徑】新安裝用全新空白目錄；維護／更新時保留原值及檔案。
# 範例：/volume1/docker/labor-union-nas-dsm-20261020/storage
# 新安裝需先建立 app-data、controlled-files、line-media、knowledge 四個空白子目錄。
NAS_DATA_ROOT=

# 【必填：NAS 位址】只填固定內網 IPv4，不含 https:// 或連接埠。
# 範例：192.168.1.100。供初次產生內部 TLS 憑證；本版不發布管理容器主機埠。
NAS_BIND_IP=

# 【選填：管理網域】例如 admin.你的DDNS名稱.synology.me；不含協定、port 或路徑。
# 只影響初次內部憑證，不會申請公信憑證或建立 DNS；DSM 憑證另外設定。
NAS_MANAGEMENT_HOSTNAME=

# 【使用前檢查】這是 Docker 專用網段，不是 NAS 的內網網段。
# 到 Container Manager「網路」確認不與既有網路／LAN／VPN 重疊。
# 若有重疊，兩項一起換成未使用的私有網段與其中的可用 IP；不要使用網關位址。
NAS_PROXY_SUBNET=172.31.250.0/29
NAS_PROXY_API_IP=172.31.250.2
# DSM 反向代理目的地為 HTTPS、NAS_PROXY_API_IP、8443；瀏覽器使用管理網域的 19443。

# 預設只啟動 MySQL、Redis、管理 API 與兩個一次性初始化服務。
# 調整啟用組別時依 README 的套用流程操作，不能只按「重新啟動」。
# 一次測一組：durable、knowledge、incident、monitor、line、tunnel、line-check。
# 多組以逗號分隔，例如 line,monitor。不要用 * 一次啟動全部服務。
# line-check 會連帶啟動 line-api，但 LINE Worker 只 --check，完成即退出。
COMPOSE_PROFILES=

# 【啟動 line／tunnel／line-check 前必填】從 LINE Developers 取得；不要把實際值提交 Git。
# 值含 $ 時使用單引號，例如 LINE_CHANNEL_SECRET='實際值'。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=

# 【對外階段填網域】範例：https://line.example.com；此值供監測使用。
# Tunnel 路由請另在 cloudflared.example.yaml 的兩個 hostname 填相同網域，
# 存成 tunnel/config.yaml；該 YAML 不會自動展開 .env。
LINE_PUBLIC_BASE_URL=
# 選填：可供監測檢查的公開 LIFF 網址；不填則顯示尚未設定。
LINE_LIFF_HEALTH_URL=

# 以下是目前採用的基礎映像標籤，不包含專案新程式；下載與實機驗證另行執行。
MYSQL_IMAGE=mysql:8.0.46
REDIS_IMAGE=redis:7-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.1

# 相容預設；容量／時間一旦從管理網頁保存，後續以持久化設定檔為準。
FILE_PHOTO_MAX_BYTES=10485760
FILE_RESUME_MAX_BYTES=20971520
FILE_TRANSFER_TIMEOUT_SECONDS=60

# 記憶體上限，非實測用量；2 GB NAS 先基本組，再逐組測試。
# DS220+ 不支援本次 NanoCPUS 配額，因此正式 Compose 不設定 cpus。
NAS_MANAGEMENT_MEMORY=768m
NAS_LINE_MEMORY=384m

# DB 密碼、各 Worker／照片代理 token、私人憑證由初始化產生，不在這裡手動填。
# root 帳號由首次開啟 /setup 時建立，保留既有 MFA 登入流程。
