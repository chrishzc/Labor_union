      "id": "LINE-ORDER-SERVICE-START-DAY-CARD-V1",
      "name": "服務當天群組繳款提醒與月嫂服務狀況詢問",
      "category": "order_lifecycle",
      "message_type": "flex",
      "enabled": true,
      "content": {
        "type": "flex",
        "altText": "服務開始提醒與服務狀況詢問",
        "contents": {
          "type": "bubble",
          "body": {
            "type": "box",
            "layout": "vertical",
            "contents": [
              {
                "type": "text",
                "text": "【服務開始提醒】\n案件編號：{case_no}\n今天是本案的服務開始日，祝服務順利！\n\n{first_payment_notice}\n\n{caregiver_names}，請問今天的服務是否順利？",
                "wrap": true
              }
            ]
          },
          "footer": {
            "type": "box",
            "layout": "vertical",
            "contents": [
              {
                "type": "button",
                "action": {
                  "type": "postback",
                  "label": "服務正常",
                  "data": "start-day:{response_token}:normal"
                }
              },
              {
                "type": "button",
                "action": {
                  "type": "postback",
                  "label": "需要協助",
                  "data": "start-day:{response_token}:help"
                }
              }
            ]
          }
        }
      },
      "variables": [
        {
          "name": "case_no",
          "required": true,
          "description": "案件編號"
        },
        {
          "name": "first_payment_notice",
