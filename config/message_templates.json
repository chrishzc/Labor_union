    {
      "id": "new_user_d1",
      "name": "新好友 D+1 服務須知",
      "category": "scheduled_push",
      "message_type": "text",
      "enabled": true,
      "content": "【新手爸媽照護指南 🌸】\n您好！坐月子是媽媽產後休養的重要時期。\n\n如果您已在市府月子平台登記，別忘了點選下方選單【服務登記】完成 60 題需求問卷，工會將為您精準媒合最合適的優質月嫂！\n\n如有任何問題，直接在對話框輸入「服務說明」即可隨時查詢。",
      "variables": [],
      "usage": [
        "schedule"
      ]
    },
    {
      "id": "new_user_d2",
      "name": "新好友 D+2 履約保證",
