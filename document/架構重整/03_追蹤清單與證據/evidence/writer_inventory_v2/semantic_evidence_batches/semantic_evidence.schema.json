{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labor-union://writer-inventory-v2/semantic-evidence/v1",
  "title": "Inventory v2 semantic evidence row",
  "x-high-risk-policy": {
    "meaning": "Architecture remediation or review priority, not general business importance.",
    "rules": [
      "Hidden API transaction boundaries and cross-Domain ownership violations are high risk.",
      "A valid typed port may still be high risk when it participates in a cross-Domain atomic transaction; this is transaction criticality, not an ownership violation.",
      "Root, replay, idempotency, occupancy, lock, aggregate-version, privacy-sensitive import, or cross-Domain bootstrap mutations may be high risk.",
      "A canonical read is not high risk unless the evidence proves sensitive-data exposure or an ownership violation.",
      "Shared infrastructure importance alone does not make a finding high risk."
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "inventory_row_number",
    "finding_identity",
    "finding_identity_digest",
    "live_source_sha256",
    "writer_kind",
    "semantic_evidence",
    "suggestion",
    "effective_disposition",
    "approved_to_remove"
  ],
  "properties": {
    "contract": {
      "const": "production-writer-semantic-evidence/v1"
    },
    "inventory_row_number": {
      "type": "integer",
      "minimum": 1
    },
    "finding_identity": {
      "type": "object"
    },
    "finding_identity_digest": {
      "$ref": "#/$defs/sha256"
    },
    "live_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "writer_kind": {
      "enum": [
        "static_sql_mutation",
        "dynamic_sql_unresolved",
        "transaction_boundary"
      ]
    },
    "semantic_evidence": {
      "$ref": "#/$defs/semanticEvidence"
    },
    "suggestion": {
      "$ref": "#/$defs/suggestion"
    },
    "effective_disposition": {
      "const": "blocked"
    },
    "approved_to_remove": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "callerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "symbol",
        "line",
        "call_type",
        "evidence"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "call_type": {
          "enum": [
            "direct",
            "indirect",
            "dependency_injection",
            "route_entry",
            "worker_entry",
            "internal_helper",
            "unit_of_work"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "architectureReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line_start",
        "line_end",
        "evidence"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semanticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_location",
        "architecture_references",
        "caller_evidence",
        "negative_caller_evidence",
        "writer_type",
        "high_risk",
        "high_risk_categories",
        "high_risk_reasons"
      ],
      "properties": {
        "architecture_location": {
          "enum": [
            "global",
            "global.performance_ux",
            "global.deployment_governance",
            "orders",
            "assignments_scheduling",
            "payroll",
            "client_finance",
            "staff_payables",
            "government_subsidy",
            "finance_import",
            "anomalies",
            "case_import",
            "contract_integration",
            "line_integration",
            "access_control",
            "knowledge_retrieval"
          ]
        },
        "architecture_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/architectureReference"
          }
        },
        "caller_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/callerEvidence"
          }
        },
        "negative_caller_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/negativeCallerEvidence"
          }
        },
        "writer_type": {
          "enum": [
            "allowed_read",
            "application_transaction_boundary",
            "api_hidden_transaction_boundary",
            "canonical_repository_writer",
            "cross_domain_writer"
          ]
        },
        "high_risk": {
          "type": "boolean"
        },
        "high_risk_categories": {
          "type": "array",
          "items": {
            "enum": [
              "hidden_transaction_boundary",
              "cross_domain_ownership",
              "cross_domain_transaction_criticality",
              "financial_state_mutation",
              "replay_or_idempotency_mutation",
              "occupancy_or_lock_mutation",
              "aggregate_version_mutation",
              "privacy_sensitive_import_mutation",
              "cross_domain_bootstrap_mutation",
              "financial_ledger_or_settlement_mutation",
              "refund_or_reversal_mutation",
              "security_identity_or_session_mutation",
              "external_delivery_or_signature_mutation",
              "deployment_or_expiry_governance_mutation"
            ]
          }
        },
        "high_risk_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "negativeCallerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_roots",
        "queries",
        "query_results",
        "result",
        "evidence"
      ],
      "properties": {
        "search_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "query_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/queryResult"
          }
        },
        "result": {
          "const": "no_live_caller_found"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "queryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "matches"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/searchMatch"
          }
        }
      }
    },
    "searchMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "text"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_type",
        "confidence",
        "evidence",
        "counter_evidence",
        "unresolved_questions",
        "requires_strong_model_review",
        "effective_disposition",
        "approved_to_remove"
      ],
      "properties": {
        "candidate_type": {
          "enum": [
            "allowed_read_candidate",
            "allowed_transaction_boundary_candidate",
            "canonical_writer_candidate",
            "migrate_writer_candidate",
            "unresolved"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "counter_evidence": {
          "type": "string"
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_strong_model_review": {
          "const": true
        },
        "effective_disposition": {
          "const": "blocked"
        },
        "approved_to_remove": {
          "const": false
        }
      }
    }
  }
}
