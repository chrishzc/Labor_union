# File: .gitattributes
# Description: 固定跨平台文字行尾與二進位資產，並保留 ZIP 內 Windows launcher 的 CRLF。
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.sql  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.ps1  text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
scripts/launchers/start_local_development.bat -text whitespace=cr-at-eol

*.xlsx binary
*.xls  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
