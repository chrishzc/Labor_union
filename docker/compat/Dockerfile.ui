FROM python:3.11-slim-bookworm@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91 AS runtime

ARG APP_RELEASE_VERSION=compat-local
ENV APP_RELEASE_VERSION=${APP_RELEASE_VERSION} \
    PATH=/app/.venv/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

RUN groupadd --gid 10001 app && \
    useradd --uid 10001 --gid 10001 --create-home --home-dir /home/app app

COPY pyproject.toml uv.lock ./
RUN python -m pip install --no-cache-dir uv==0.11.11 && \
    uv sync --frozen --no-dev --no-install-project --no-cache

COPY --chown=10001:10001 .streamlit ./.streamlit
COPY --chown=10001:10001 api ./api
COPY --chown=10001:10001 config ./config
COPY --chown=10001:10001 db/form_templates.json ./db/form_templates.json
COPY --chown=10001:10001 db/templates ./db/templates
COPY --chown=10001:10001 domains ./domains
COPY --chown=10001:10001 infrastructure ./infrastructure
COPY --chown=10001:10001 line ./line
COPY --chown=10001:10001 scripts ./scripts
COPY --chown=10001:10001 services ./services
COPY --chown=10001:10001 shared_kernel ./shared_kernel
COPY --chown=10001:10001 subsystems ./subsystems
COPY --chown=10001:10001 ui ./ui

RUN mkdir -p /app/runtime_data /app/.local_media /app/.monitor_state && \
    chown -R 10001:10001 /app/db /app/runtime_data /app/.local_media /app/.monitor_state

USER 10001:10001

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=6 \
    CMD python -c "from urllib.request import urlopen; raise SystemExit(0 if urlopen('http://127.0.0.1:' + __import__('os').environ.get('PORT', '8080') + '/_stcore/health', timeout=2).status == 200 else 1)"

CMD ["sh", "-c", "exec python -m streamlit run ui/app.py --server.address=0.0.0.0 --server.port=\"${PORT:-8080}\" --server.headless=true"]
