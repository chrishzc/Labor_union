# File: .env.example
# Description: 工會電腦正式地端部署環境變數範本（含 NAS MySQL、本機 Redis、Cloudflare Tunnel 入口與生產預設參數）。
#
# 新竹市月子公會自動化系統 - 正式地端部署範本
# 複製為 .env 後填入部署值；請勿提交 .env、密鑰、密碼或內部路徑。
# 有安全預設值的參數不在此重複列出。

# =============================================================================
# 部署身分與公開入口
# =============================================================================
APP_ENV=production
APP_RELEASE_VERSION=v1.0.0
# 允許跨域請求來源：含遠端 Cloudflare Tunnel 管理域名與本機 Loopback 管理入口。
ALLOWED_ORIGINS=https://chrishzc.com,http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# 管理端授權
# =============================================================================
ACCESS_CONTROL_PROFILE=production
ENABLE_ADMIN_AUTH=true

# 格式：v1:<Fernet key>[,v2:<Fernet key>]；active version 必須存在於 keyring。
ACCESS_CONTROL_TOTP_KEYRING=replace_with_versioned_fernet_keyring
ACCESS_CONTROL_TOTP_ACTIVE_KEY_VERSION=v1

# =============================================================================
# Private MySQL 與 Redis
# =============================================================================
# MySQL 不得公開對外；預設連向區網 Synology NAS 固定 IP（配合 deployment/nas 部署）。
DB_HOST=192.168.1.100
DB_PORT=3306
DB_USER=union_app
DB_PASSWORD=replace_with_application_db_password
DB_DATABASE=union_db

# MySQL 執行緒安全常駐連線池預設參數（配合 Synology NAS 2GB RAM／max_connections=60）：
# - DB_POOL_MAX_IDLE：單一程序保留的熱連線上限（預設 10；設為 0 可緊急關閉連線池）
# - DB_POOL_MAX_AGE_SECONDS：單條連線最長存活秒數（預設 300 秒自動輪替）
# - DB_POOL_PING_IDLE_SECONDS：閒置超過幾秒借用前先輕量 ping 探測斷線（預設 15 秒）
DB_POOL_MAX_IDLE=10
DB_POOL_MAX_AGE_SECONDS=300
DB_POOL_PING_IDLE_SECONDS=15

# 工會電腦本機 Redis（對應 docker-compose.yml 的 union_redis）：
# - 預設連向本機 127.0.0.1:6379 啟用 L1＋Redis 雙層唯讀投影快取
# - 若留空或 Redis 暫時離線，會於 150ms 內自動退回單程序記憶體快取（5 秒冷卻保護）
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# =============================================================================
# React Admin 不可變前端產物（正式部署由 build_react_admin_artifact.py 產製）
# =============================================================================
# current 與 previous 必須是不同且已驗證存在的絕對路徑；selector 可填 current 或 previous。
REACT_ADMIN_CURRENT_ARTIFACT_DIR=C:/ProgramData/Labor_union/artifacts/current
REACT_ADMIN_PREVIOUS_ARTIFACT_DIR=C:/ProgramData/Labor_union/artifacts/previous
REACT_ADMIN_ACTIVE_SELECTOR=current
ADMIN_ENTRY_TARGET_STATE_PATH=C:/ProgramData/Labor_union/runtime/admin-entry-targets.json

# =============================================================================
# 正式持久化空間（請使用受管、可備份且不位於 source tree 的絕對路徑）
# =============================================================================
# Windows 正式機只設定 NAS 共用根目錄；程式在寫入時自動建立規格 13B 的 01～05 與 _staging。
# 根目錄須已存在且可存取；不自動建立共用、不回存本機。請替換真正的 NAS／共用名稱。
CONTROLLED_FILE_STORAGE_ROOT=\\nas-server\工會資料
# 正式環境不再使用 MEDIA_STORAGE_ROOT 或 CONTRACT_DOCUMENT_ARCHIVE_ROOT；原開發設定與資料不搬移。

# =============================================================================
# LINE Messaging API、Login 與 LIFF
# =============================================================================
LINE_CHANNEL_SECRET=replace_with_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_with_line_channel_access_token
LINE_LIFF_ID=replace_with_liff_id
# LINE Login Channel ID，不是 LIFF ID 或 Messaging API Channel ID。
LINE_LOGIN_CHANNEL_ID=replace_with_line_login_channel_id
# 正式 LINE 外部公開網域名稱（由 Cloudflare Tunnel 提供 HTTPS）。
LINE_PUBLIC_BASE_URL=https://line.chrishzc.com
LIFF_REQUIRE_ID_TOKEN=true

# =============================================================================
# Worker／Monitor → Private Operations API
# =============================================================================
# 工會電腦本機監督器（supervise_local_runtime.ps1）預設使用 local_shared_key：
# 每次啟動時會自動產生一次性隨機金鑰傳給背景 Workers，日常無需手動填寫。
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_AUTH_MODE=local_shared_key
# INTERNAL_SERVICE_SHARED_KEY=（選填，至少 32 字元；留空則由監督器自動生成）

# =============================================================================
# 客戶訂金繳費設定
# =============================================================================
# 訂金繳費頁的三碼銀行代碼（預設 807 永豐銀行）；專屬虛擬帳號由 Client Finance 既有規則決定。
# 若未確認合作銀行時可留空，系統會自動保留人員待辦、暫不寄出。
CLIENT_DEPOSIT_BANK_CODE=807
