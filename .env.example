# File: .env.example
# Description: 工會電腦正式地端部署環境變數範本（含 NAS MySQL 連線池與本機 Redis 預設參數，不含密鑰）。
#
# 新竹市月子公會自動化系統 - 正式地端部署範本
# 複製為 .env 後填入部署值；請勿提交 .env、密鑰、密碼或內部路徑。
# 有安全預設值的參數不在此重複列出。

# =============================================================================
# 部署身分與公開入口
# =============================================================================
APP_ENV=production
APP_RELEASE_VERSION=replace_with_release_version
ALLOWED_ORIGINS=https://admin.example.com

# =============================================================================
# 管理端授權
# =============================================================================
ACCESS_CONTROL_PROFILE=production
ENABLE_ADMIN_AUTH=true

# 格式：v1:<Fernet key>[,v2:<Fernet key>]；active version 必須存在於 keyring。
ACCESS_CONTROL_TOTP_KEYRING=replace_with_versioned_fernet_keyring
ACCESS_CONTROL_TOTP_ACTIVE_KEY_VERSION=v1

# =============================================================================
# Private MySQL 與 Redis
# =============================================================================
# MySQL 不得公開對外；請填入區網 Synology NAS 固定 IP 與最小權限正式應用程式帳號。
DB_HOST=replace_with_private_db_host
DB_PORT=3306
DB_USER=replace_with_application_db_user
DB_PASSWORD=replace_with_application_db_password
DB_DATABASE=union_db

# MySQL 執行緒安全常駐連線池預設參數（配合 Synology NAS 2GB RAM／max_connections=60）：
# - DB_POOL_MAX_IDLE：單一程序保留的熱連線上限（預設 10；設為 0 可緊急關閉連線池）
# - DB_POOL_MAX_AGE_SECONDS：單條連線最長存活秒數（預設 300 秒自動輪替）
# - DB_POOL_PING_IDLE_SECONDS：閒置超過幾秒借用前先輕量 ping 探測斷線（預設 15 秒）
DB_POOL_MAX_IDLE=10
DB_POOL_MAX_AGE_SECONDS=300
DB_POOL_PING_IDLE_SECONDS=15

# 工會電腦本機 Redis（對應 docker-compose.yml 的 union_redis）：
# - 預設連向本機 127.0.0.1:6379 啟用 L1＋Redis 雙層唯讀投影快取
# - 若留空或 Redis 暫時離線，會於 150ms 內自動退回單程序記憶體快取（5 秒冷卻保護）
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# =============================================================================
# React Admin immutable artifacts
# =============================================================================
# current 與 previous 必須是不同且已驗證的絕對路徑。
REACT_ADMIN_CURRENT_ARTIFACT_DIR=replace_with_current_artifact_absolute_path
REACT_ADMIN_PREVIOUS_ARTIFACT_DIR=replace_with_previous_artifact_absolute_path
REACT_ADMIN_ACTIVE_SELECTOR=current
ADMIN_ENTRY_TARGET_STATE_PATH=replace_with_durable_state_absolute_path

# =============================================================================
# 正式持久化空間
# =============================================================================
# 請使用受管、可備份且不位於 source tree 的絕對路徑。
MEDIA_STORAGE_ROOT=replace_with_media_storage_absolute_path
CONTROLLED_FILE_STORAGE_ROOT=replace_with_controlled_file_storage_absolute_path
CONTRACT_DOCUMENT_ARCHIVE_ROOT=replace_with_contract_archive_absolute_path

# =============================================================================
# LINE Messaging API、Login 與 LIFF
# =============================================================================
LINE_CHANNEL_SECRET=replace_with_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_with_line_channel_access_token
LINE_LIFF_ID=replace_with_liff_id
# LINE Login Channel ID，不是 LIFF ID 或 Messaging API Channel ID。
LINE_LOGIN_CHANNEL_ID=replace_with_line_login_channel_id
LINE_PUBLIC_BASE_URL=https://line.example.com
LIFF_REQUIRE_ID_TOKEN=true

# =============================================================================
# Worker／Monitor → Private Operations API
# =============================================================================
# 現行 production 契約只接受 Google-signed OIDC，不接受 local shared key。
INTERNAL_API_BASE_URL=https://private-api.example.com
INTERNAL_SERVICE_AUTH_MODE=google_oidc
INTERNAL_SERVICE_OIDC_AUDIENCE=replace_with_private_api_audience
# 格式：service=service-account-email，多個 caller 以逗號分隔。
INTERNAL_SERVICE_OIDC_ALLOWED_CALLERS=replace_with_service_account_allowlist

# 訂金繳費頁的三碼銀行代碼；未確認時留空，提醒保留人員待辦、不寄出。
# 專屬虛擬帳號仍由 Client Finance 既有規則／匯入對照決定。
CLIENT_DEPOSIT_BANK_CODE=
