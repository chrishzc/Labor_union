# File: .env.example
# Description: 工會單一 Windows 主機正式環境範本（含本機 Docker MySQL、本機 Redis、受控檔案儲存與 Cloudflare Tunnel 參數）。
#
# 新竹市月子公會自動化系統 - 單一主機部署範本
# 複製為 .env 後填入部署值；請勿提交 .env、密鑰、密碼或內部路徑。
# 日常從 Windows管理.bat 啟動時會沿用受控登入設定（ACCESS_CONTROL_PROFILE=production）。
# 有安全預設值的參數不在此重複列出。

# =============================================================================
# 部署身分與公開入口
# =============================================================================
APP_ENV=production
APP_RELEASE_VERSION=v1.0.0
# 允許跨域請求來源：含遠端 Cloudflare Tunnel 管理域名與本機 Loopback 管理入口。
ALLOWED_ORIGINS=https://chrishzc.com,http://localhost:5173,http://127.0.0.1:5173
# 遠端管理端顯示入口（選填，留空自動由 ALLOWED_ORIGINS 判定）：
# PUBLIC_ORIGIN=https://chrishzc.com/test/

# =============================================================================
# 管理端授權
# =============================================================================
ACCESS_CONTROL_PROFILE=production
ENABLE_ADMIN_AUTH=true

# 格式：v1:<Fernet key>[,v2:<Fernet key>]；active version 必須存在於 keyring。
# 首次建帳前：停止網站，執行 scripts\launchers\configure_initial_totp_key.bat。
# 工具僅在本機帳號及驗證資料皆為空時建立金鑰；有效金鑰保留，已存在帳號時拒絕替換。
ACCESS_CONTROL_TOTP_KEYRING=v1:replace_with_fernet_key
ACCESS_CONTROL_TOTP_ACTIVE_KEY_VERSION=v1
# 帳號收據使用獨立的 32 位元組隨機金鑰，以 URL-safe Base64 編碼。
# 正式機將金鑰與 SQL 備份分開保管。復原資料時須使用同一把金鑰。
ACCESS_CONTROL_ACCOUNT_RECEIPT_HMAC_KEY=
# 本機開發驗證請使用 ACCESS_CONTROL_PROFILE=local_auth 與 ENABLE_ADMIN_AUTH=true

# =============================================================================
# Private MySQL 與 Redis（同機 Docker 容器，限綁定 127.0.0.1）
# =============================================================================
# MySQL 由根目錄 docker-compose.yml 的 db（mysql_db）提供；應用程式一律經 127.0.0.1 連線。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=union_app
DB_PASSWORD=replace_with_application_db_password
DB_DATABASE=union_db
# 初次初始化全新 Docker MySQL volume（mysql-data）時使用；已有資料卷不會被覆寫：
# MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password
# MYSQL_APP_USER=union_app
# MYSQL_APP_PASSWORD=replace_with_application_db_password
# 若啟用 MySQL TLS 驗證（選填）：
# DB_SSL_MODE=verify_identity
# DB_SSL_CA=path_to_mysql_ca_certificate

# MySQL 執行緒安全常駐連線池預設參數：
# - DB_POOL_MAX_IDLE：單一程序保留的熱連線上限（預設 10；設為 0 可緊急關閉連線池）
# - DB_POOL_MAX_AGE_SECONDS：單條連線最長存活秒數（預設 300 秒自動輪替）
# - DB_POOL_PING_IDLE_SECONDS：閒置超過幾秒借用前先輕量 ping 探測斷線（預設 15 秒）
DB_POOL_MAX_IDLE=10
DB_POOL_MAX_AGE_SECONDS=300
DB_POOL_PING_IDLE_SECONDS=15

# 工會電腦本機 Redis（對應 docker-compose.yml 的 union_redis）：
# - 預設連向本機 127.0.0.1:6379 啟用 L1＋Redis 雙層唯讀投影快取
# - 留空使用單程序記憶體快取；Redis 連線／讀取逾時各設 150ms，失敗後有 5 秒冷卻保護
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# 公開 LINE 線上申請待審專區（對應 docker-compose.yml 的 registration profile）：
# REGISTRATION_REDIS_HOST=127.0.0.1
# REGISTRATION_REDIS_PORT=6380
# REGISTRATION_INTAKE_PORT=8080
# REGISTRATION_REDIS_INTAKE_PASSWORD_FILE=C:\ProgramData\Labor_union\secrets\registration-intake-password
# REGISTRATION_REDIS_ADMIN_PASSWORD_FILE=C:\ProgramData\Labor_union\secrets\registration-admin-password

# =============================================================================
# React Admin 前端靜態產物（選填，日常 Vite 源碼模式請保持留空）
# =============================================================================
# 僅在透過 build_react_admin_artifact.py 編譯產物並以此模式部署時填寫。
# 靜態產物模式須同時填入不同的 current／previous 絕對路徑，selector 填 current 或 previous。
REACT_ADMIN_CURRENT_ARTIFACT_DIR=
REACT_ADMIN_PREVIOUS_ARTIFACT_DIR=
REACT_ADMIN_ACTIVE_SELECTOR=
ADMIN_ENTRY_TARGET_STATE_PATH=C:/ProgramData/Labor_union/runtime/admin-entry-targets.json

# =============================================================================
# 正式持久化空間（請使用受管、可備份且不位於 source tree 的本機絕對路徑）
# =============================================================================
# 請指定這台 Windows 主機上的獨立儲存資料夾完整絕對路徑（例如 D:\Labor_union_storage）；
# 程式在寫入時自動建立 01～05 與 _staging，並請自行設定異地／外接備份。
CONTROLLED_FILE_STORAGE_ROOT=D:\Labor_union_storage

# =============================================================================
# LINE Messaging API、Login 與 LIFF
# =============================================================================
LINE_CHANNEL_SECRET=replace_with_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_with_line_channel_access_token
LINE_LIFF_ID=replace_with_liff_id
# LINE Login Channel ID，不是 LIFF ID 或 Messaging API Channel ID。
LINE_LOGIN_CHANNEL_ID=replace_with_line_login_channel_id
# 正式 LINE 外部公開網域名稱（由 Cloudflare Tunnel 提供 HTTPS）。
LINE_PUBLIC_BASE_URL=https://line.chrishzc.com
LIFF_REQUIRE_ID_TOKEN=true

# =============================================================================
# Worker／Monitor → Private Operations API
# =============================================================================
# 工會電腦本機監督器（supervise_local_runtime.ps1）預設使用 local_shared_key：
# 每次啟動時會自動產生一次性隨機金鑰傳給背景 Workers，日常無需手動填寫。
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_AUTH_MODE=local_shared_key
# INTERNAL_SERVICE_SHARED_KEY=（選填，至少 32 字元；留空則由監督器自動生成）

# =============================================================================
# 客戶訂金繳費設定
# =============================================================================
# 訂金繳費頁的三碼銀行代碼（預設 807 永豐銀行）；專屬虛擬帳號由 Client Finance 既有規則決定。
# 若未確認合作銀行時可留空，系統會自動保留人員待辦、暫不寄出。
CLIENT_DEPOSIT_BANK_CODE=807

# =============================================================================
# 選填擴充功能（通勤計算、知識庫問答、合約轉檔）
# =============================================================================
# Google Maps Routes API 金鑰（選填，供媒合計算月嫂通勤距離與機車車程）：
# GOOGLE_MAPS_ROUTES_API_KEY=

# LINE 知識庫問答與 LLM 助理（選填，預設關閉）：
# KNOWLEDGE_RETRIEVAL_RUNTIME_ENABLED=false
# GEMINI_MODEL=gemini-3.5-flash-lite
# KNOWLEDGE_CHROMA_PATH=db/chroma_knowledge

# 合約 PDF 轉檔（選填，預設使用 Playwright Chromium；若使用 LibreOffice 可指定可執行檔路徑）：
# CONTRACT_PDF_RENDERER_EXECUTABLE=C:\Program Files\LibreOffice\program\soffice.com
