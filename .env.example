# 新竹市月子公會自動化系統 - 環境變數範本
# 請複製此檔案並命名為 .env，然後填入實際的金鑰與設定值

# LINE Messaging API 設定
LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# legacy 與 canonical 互斥；production 預設只允許 canonical
LINE_WEBHOOK_RUNTIME_MODE=canonical
# legacy/canonical/compatibility；compatibility 永遠禁止用於 production
LINE_WORKER_RUNTIME_MODE=canonical
# 僅限正式切換失敗後的受控 rollback；正常 production 必須為 false
LINE_LEGACY_ROLLBACK_MODE=false
# Redis 僅負責喚醒，MySQL 仍是可靠任務來源
REDIS_URL=redis://127.0.0.1:6379/0
LINE_LOGIN_SECRET=your_line_login_secret_here

# LINE LIFF 與系統對外網址設定
LINE_LIFF_ID=your_liff_id_here
# LIFF 所屬的 LINE Login Channel ID（不是 LIFF ID，也不是 Messaging API Channel ID）
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here
# 無 LIFF ID 時，canonical Worker 產生身分驗證連結所使用的公開 HTTPS 根網址
LINE_PUBLIC_BASE_URL=https://your-public-domain.example
# 正式環境預設強制驗證；僅供本機測試時可明確設為 false
LIFF_REQUIRE_ID_TOKEN=true
APP_ENV=development
# false 僅允許開發環境略過登入；production 永遠強制登入
ENABLE_ADMIN_AUTH=true
API_BASE_URL=http://127.0.0.1:8000
# Worker／Monitor 呼叫 Private Operations API；本機 launcher 未設定時會產生一次性隨機 key。
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
# 可留空交由本機 launcher 產生；禁止提交 production key。production 不接受此 shared-key 模式。
INTERNAL_SERVICE_SHARED_KEY=
# local/test 使用 local_shared_key；Cloud Run production 固定使用 google_oidc。
INTERNAL_SERVICE_AUTH_MODE=local_shared_key
# Cloud Run Private API 的 canonical service URL，也是 OIDC token audience。
INTERNAL_SERVICE_OIDC_AUDIENCE=
# service=service-account-email，以逗號分隔；每個 Worker 使用獨立 service account。
INTERNAL_SERVICE_OIDC_ALLOWED_CALLERS=
# 單一 private operation 的 transport retry budget；永久錯誤不會使用此額度。
INTERNAL_API_MAX_ATTEMPTS=3
# 部署 revision；Cloud Run 會提供 K_REVISION，本機可留空。
APP_RELEASE_VERSION=
# React Admin production artifact；production 必須同時提供兩個不同且已驗證的 immutable directories。
REACT_ADMIN_CURRENT_ARTIFACT_DIR=
REACT_ADMIN_PREVIOUS_ARTIFACT_DIR=
# 只允許 current 或 previous；不依 mtime、symlink 或目錄順序猜選。
REACT_ADMIN_ACTIVE_SELECTOR=current
# Deployment-owned durable entry target state；必須是 source／cwd／temp／個人 profile 之外的絕對路徑。
# Startup 只做唯讀 attestation，不會自動建立、修復或覆寫此檔案。
ADMIN_ENTRY_TARGET_STATE_PATH=
# React/Vite 管理端來源；正式環境請改為實際管理後台網址。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_LINE_REVIEW_CONSOLE=true
# 人工審查等待超過此時數時，在管理中心顯示逾時提醒
LINE_REVIEW_STALE_HOURS=24
ENABLE_SERVER_FAILURE_POPUP=false
ENABLE_REBIND_CONSOLE_REVIEW=false
BASE_URL=https://your-public-domain.example
# Rich Menu／LINE 圖片檔案儲存根目錄；正式環境建議指向 NAS 或受控磁碟
MEDIA_STORAGE_ROOT=.local_media
MEDIA_STORAGE_PROVIDER=local
# Global controlled-file storage root；未設定時 staging／download fail closed，不回退到 MEDIA_STORAGE_ROOT。
CONTROLLED_FILE_STORAGE_ROOT=

# Knowledge Retrieval：MySQL 是 SSOT，ChromaDB 只保存可重建索引。
KNOWLEDGE_RETRIEVAL_RUNTIME_ENABLED=false
KNOWLEDGE_CHROMA_PATH=db/chroma_knowledge

# 資料庫連線配置：只可提供給 FastAPI／migration，不得提供給 Worker 或 Monitor service。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_DATABASE=union_db
# 若 MySQL CLI 在 Docker 容器內，填入容器名稱（例如 mysql_db）；每位開發者可不同。
MYSQL_CONTAINER=
